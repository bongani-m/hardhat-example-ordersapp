# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Example of extracting secrets from 1password (or another compatible pw manager)
# Item: vault "kamal", item "hardhat-example-ordersapp".
#
# MYSQL_ADDR is public-ip:3306 of a HardhatDB node. The certificate names that IP.
# KV_ADDR is public-ip:6399. KV_PASSWORD is the Redis AUTH password.
# AMQP_URL is amqps://root:<password>@public-ip:5672. The host is the HardhatQ public IP.
# MYSQL_TLS_CA_PEM and AMQP_TLS_CA_PEM are the CA downloads from each cluster.
SECRETS=$(kamal secrets fetch --adapter 1password --account FPIS3OEKGNEBDFIHPPXGMAIAZ4 --from kamal/hardhat-example-ordersapp KAMAL_REGISTRY_USERNAME KAMAL_REGISTRY_PASSWORD MYSQL_ADDR MYSQL_PASSWORD MYSQL_TLS_CA_PEM KV_ADDR KV_PASSWORD AMQP_URL AMQP_TLS_CA_PEM)

KAMAL_REGISTRY_USERNAME=$(kamal secrets extract KAMAL_REGISTRY_USERNAME ${SECRETS})
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
MYSQL_ADDR=$(kamal secrets extract MYSQL_ADDR ${SECRETS})
MYSQL_PASSWORD=$(kamal secrets extract MYSQL_PASSWORD ${SECRETS})
MYSQL_TLS_CA_PEM=$(kamal secrets extract MYSQL_TLS_CA_PEM ${SECRETS})
KV_ADDR=$(kamal secrets extract KV_ADDR ${SECRETS})
KV_PASSWORD=$(kamal secrets extract KV_PASSWORD ${SECRETS})
AMQP_URL=$(kamal secrets extract AMQP_URL ${SECRETS})
AMQP_TLS_CA_PEM=$(kamal secrets extract AMQP_TLS_CA_PEM ${SECRETS})
